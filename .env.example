# Application database. Use a dedicated application user in real environments.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=competitive_intel
DB_USER=competitive_intel_app
DB_PASSWORD=change_me
DB_CHARSET=utf8mb4
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
DB_ECHO=false

# Search is provider-neutral. Fixture mode needs no API key or network.
SEARCH_PROVIDER=fixture
SEARCH_API_KEY=
SEARCH_ENDPOINT=https://google.serper.dev/search

# Fact extraction defaults to deterministic fixture mode.
LLM_PROVIDER=fixture
LLM_API_KEY=
LLM_MODEL=
LLM_ENDPOINT=

# Controlled tool-calling agent defaults to deterministic fixture mode.
AGENT_PROVIDER=fixture
AGENT_API_KEY=
AGENT_MODEL=
AGENT_ENDPOINT=

# Local web console. Keep the default loopback-only binding.
WEB_MAX_CONCURRENT_ANALYSES=2

# Integration tests MUST use a disposable database, never the application database.
# A full URL takes precedence over the TEST_DB_* variables.
# TEST_DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/competitive_intel_test?charset=utf8mb4
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_NAME=competitive_intel_test
TEST_DB_USER=competitive_intel_test
TEST_DB_PASSWORD=change_me
